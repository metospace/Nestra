{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nestra",
  "version": "0.1.0",
  "identifier": "app.nestra.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "desktop",
        "title": "Nestra 桌面层",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": true,
        "shadow": false
      },
      {
        "label": "manager",
        "title": "Nestra 管理器",
        "url": "index.html#manager",
        "width": 1020,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/cache/icons/*",
          "$APPCACHE/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
